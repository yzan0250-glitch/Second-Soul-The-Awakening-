{
  "expo": {
    "name": "Second Soul",
    "slug": "second-soul",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#020205"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.secondsoul.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Second Soul uses motion data to observe your daily step patterns.",
        "NSHealthShareUsageDescription": "Second Soul reads step count data from HealthKit to power your soul's pulse.",
        "NSHealthUpdateUsageDescription": "Second Soul does not write any data to HealthKit.",
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020205"
      },
      "package": "com.secondsoul.app",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "cf99cca5-758e-4712-8442-7d6280cef2c8"
      }
    },
    "owner": "yzan"
  }
}
